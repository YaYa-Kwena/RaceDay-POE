@model RaceDay.API.DTOs.CreateEventRequestDto

<h2>Create Event</h2>
<form enctype="multipart/form-data" asp-action="CreateEvent" method="post" class="mt-3" style="max-width: 600px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="EventName" class="form-label">Event Name</label>
        <input asp-for="EventName" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="EventDate" class="form-label">Event Date</label>
            <input asp-for="EventDate" type="date" class="form-control" />
        </div>
        <div class="col">
            <label asp-for="StartTime" class="form-label">Start Time</label>
            <input asp-for="StartTime" type="time" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="LocationCity" class="form-label">City</label>
            <input asp-for="LocationCity" class="form-control" />
        </div>
        <div class="col">
            <label asp-for="LocationProvince" class="form-label">Province</label>
            <input asp-for="LocationProvince" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="EventType" class="form-label">Event Type</label>
            <select asp-for="EventType" class="form-select">
                <option value="Running">Running</option>
                <option value="Walking">Walking</option>
                <option value="Cycling">Cycling</option>
            </select>
        </div>
        <div class="col">
            <label asp-for="DistanceKm" class="form-label">Distance (Km)</label>
            <input asp-for="DistanceKm" type="number" step="0.01" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label asp-for="MaxCapacity" class="form-label">Max Capacity</label>
            <input asp-for="MaxCapacity" type="number" class="form-control" />
        </div>
        <div class="col">
            <label asp-for="RegistrationDeadline" class="form-label">Registration Deadline</label>
            <input asp-for="RegistrationDeadline" type="date" class="form-control" />
        </div>
    </div>

    <button type="submit" class="btn btn-success">Save Event</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>