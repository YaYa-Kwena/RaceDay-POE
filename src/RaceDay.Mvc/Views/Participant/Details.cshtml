@model RaceDay.API.Models.Event

<h2>@Model.EventName</h2>
<p class="text-muted">@Model.LocationCity, @Model.LocationProvince | @Model.EventDate.ToShortDateString() (@Model.StartTime)</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h4>About this Event</h4>
        <p>@Model.Description</p>
        <p><strong>Distance:</strong> @Model.DistanceKm km | <strong>Type:</strong> @Model.EventType | <strong>Max Capacity:</strong> @Model.MaxCapacity</p>
    </div>
</div>

<h4>Select a Category to Enrol</h4>
@if (Model.Categories == null || !Model.Categories.Any())
{
    <p class="text-muted">No categories have been set up for this event yet.</p>
}
else
{
    <table class="table table-bordered">
        <thead class="table-light">
            <tr>
                <th>Category Name</th>
                <th>Distance</th>
                <th>Entry Fee</th>
                <th>Restriction</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model.Categories)
            {
                <tr>
                    <td>@cat.CategoryName</td>
                    <td>@cat.DistanceKm km</td>
                    <td>R @cat.EntryFeeZAR</td>
                    <td>@cat.GenderRestriction (Ages @cat.MinAge - @cat.MaxAge)</td>
                    <td>
                        <form asp-action="EnterEvent" method="post">
                            <input type="hidden" name="eventId" value="@Model.EventID" />
                            <input type="hidden" name="categoryId" value="@cat.CategoryID" />
                            <button type="submit" class="btn btn-success btn-sm">Enter Event</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
<a asp-action="Index" class="btn btn-secondary mt-3">Back to Events</a>